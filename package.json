{
  "name": "how-much-mate-supabase",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "clean": "rm -f frontend/src/supabase/database.types.ts",
    "supabase:gen": "npx supabase gen types typescript --schema public --local > frontend/src/supabase/database.types.ts",
    "supabase:types": "npm run clean && npm run supabase:gen",
    "supabase:reset": "supabase db reset && npm run supabase:types",
    "supabase:restart": "npm run email:build && npx supabase stop && npx supabase start",
    "email:build": "tsx supabase/templates/build.tsx",
    "email:watch": "tsx watch supabase/templates/build.tsx",
    "link:dev": "supabase link --project-ref ghhzavhcgldjqdanjxgp",
    "link:local": "supabase link --project-ref gbfbpochuudzenlocfll"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sbsg35/how-much-mate-supabase.git"
  },
