  },
  "homepage": "https://github.com/sbsg35/how-much-mate-supabase#readme",
  "devDependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "react": "^19.2.7",
    "supabase": "^2.84.6",
    "tsx": "^4.23.1"
  }
}
