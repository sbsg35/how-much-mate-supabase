NEXT_PUBLIC_APP_ENV=local
APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=

# Server-side secret for verifying quote-submission Turnstile tokens via
# https://challenges.cloudflare.com/turnstile/v0/siteverify. Locally, use
# Cloudflare's published always-pass test secret: 1x0000000000000000000000000000000AA
# (same one supabase/config.toml uses for the auth captcha). Use a real secret
# from the Cloudflare dashboard in dev/prod.
TURNSTILE_SECRET_KEY=

# Local defaults use Mailpit at 127.0.0.1:54325, so these are optional locally.
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
